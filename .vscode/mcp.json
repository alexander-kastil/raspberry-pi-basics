{
    "servers": {
        "ssh-mcp": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "ssh-mcp",
                "--",
                "--host=${input:SSH_HOST}",
                "--port=22",
                "--user=${input:SSH_USER}",
                "--password=${input:SSH_PASSWORD}",
                "--sudoPassword=${input:SSH_PASSWORD}",
                "--timeout=120000",
                "--maxChars=none"
            ]
        }
    },
    "inputs": [
        {
            "id": "SSH_HOST",
            "type": "promptString",
            "description": "SSH host/IP of the Raspberry Pi",
            "default": "192.168.0.143"
        },
        {
            "id": "SSH_USER",
            "type": "promptString",
            "description": "SSH username",
            "default": "alex"
        },
        {
            "id": "SSH_PASSWORD",
            "type": "promptString",
            "description": "SSH password (used for sudo as well)",
            "password": true
        }
    ]
}